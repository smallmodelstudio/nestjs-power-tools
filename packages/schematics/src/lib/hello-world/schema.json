{
  "$schema": "http://json-schema.org/schema",
  "$id": "SchematicsHelloWorld",
  "title": "Hello World Options Schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The name to greet. Also used as the generated file name.",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What name would you like to greet?"
    },
    "path": {
      "type": "string",
      "format": "path",
      "description": "The path to create the file in."
    },
    "language": {
      "type": "string",
      "enum": ["ts", "js"],
      "default": "ts",
      "description": "The language of the generated file (ts/js)."
    },
    "sourceRoot": {
      "type": "string",
      "description": "The source root directory."
    }
  },
  "required": ["name"]
}
