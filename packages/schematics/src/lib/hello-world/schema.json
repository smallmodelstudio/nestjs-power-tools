{
  "$schema": "http://json-schema.org/schema",
  "$id": "SchematicsHelloWorld",
  "title": "Hello World Options Schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The name of the class.",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What name would you like to use for the class?"
    },
    "path": {
      "type": "string",
      "format": "path",
      "description": "The path to create the class."
    },
    "language": {
      "type": "string",
      "description": "Nest class language (ts/js)."
    },
    "sourceRoot": {
      "type": "string",
      "description": "Nest controller source root directory."
    }
  },
  "required": ["name"]
}
