{
  "name": "@nestjs-power-tools/core",
  "version": "0.0.1",
  "description": "Reusable NestJS building blocks: decorators, guards, pipes and interceptors.",
  "keywords": [
    "decorators",
    "guards",
    "interceptors",
    "nest",
    "nestjs",
    "pipes"
  ],
  "license": "MIT",
  "files": [
    "dist/**/*"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist *.tsbuildinfo && tsc -b tsconfig.lib.json",
    "check-types": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@nestjs-power-tools/typescript-config": "workspace:*",
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@types/node": "24.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@nestjs/common": ">=11.0.0",
    "@nestjs/core": ">=11.0.0",
    "reflect-metadata": ">=0.2.0",
    "rxjs": ">=7.0.0"
  }
}
