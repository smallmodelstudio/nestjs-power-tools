{
  "name": "@nestjs-power-tools/http",
  "version": "0.0.1",
  "description": "NestJS HTTP client helper: an axios-backed HttpService with configurable retry and backoff.",
  "keywords": [
    "axios",
    "http",
    "nest",
    "nestjs",
    "retry"
  ],
  "license": "MIT",
  "files": [
    "dist/**/*"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist *.tsbuildinfo && tsc -b tsconfig.lib.json",
    "check-types": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@nestjs-power-tools/typescript-config": "workspace:*",
    "@nestjs/axios": "12.0.2",
    "@nestjs/common": "12.5.1",
    "@types/node": "24.0.0",
    "axios": "1.21.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "@nestjs/axios": ">=4.0.0",
    "@nestjs/common": ">=11.0.0",
    "axios": ">=1.3.1",
    "rxjs": ">=7.0.0"
  }
}
